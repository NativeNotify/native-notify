{
  "name": "native-notify",
  "version": "5.1.0",
  "description": "Expo Push Notifications (React Native) by https://NativeNotify.com. Send your first Expo push notification in less than a minute.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NativeNotify/native-notify.git"
  },
  "keywords": [
    "expo",
    "push",
    "notifications",
    "react",
    "native",
    "notify",
    "expo push notifications",
    "expo push notification",
    "react native push notifications",
    "react native push notification",
    "expo push notifications react native",
    "expo push notification react native",
    "react native expo push notifications",
    "react native expo push notification",
    "native notify",
    "native notify push notifications"
  ],
  "author": "Native Notify, INC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NativeNotify/native-notify/issues"
  },
  "homepage": "https://github.com/NativeNotify/native-notify#readme",
  "dependencies": {
    "axios": "^1.5.1"
  },
  "peerDependencies": {
    "expo-constants": "*",
    "expo-device": "*",
    "expo-notifications": "*",
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
